:3000 {
    # All API traffic flows through nixre-core; it owns auth + sync and
    # transparently proxies not-yet-migrated endpoints to Gitness.
    handle /api/* {
        reverse_proxy nixre-core:3002
    }

    # Git Smart HTTP traffic to Gitness (moves to core in phase 2)
    handle /git/* {
        reverse_proxy nixre-backend:3000
    }

    # Serve Nixre SPA Web UI
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
