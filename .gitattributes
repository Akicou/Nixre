# Docker entrypoints break on CRLF shebangs.
*.sh text eol=lf

# Vite copies index.html verbatim, so pin the source to LF: the Windows (CRLF)
# and Linux CI builds then agree byte for byte.
ui/index.html text eol=lf

# Binary assets — never touch these.
*.woff2 binary
*.woff binary
*.ttf binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
