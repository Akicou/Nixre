# Nixre environment — copy to .env and fill in. Never commit .env.
#
# This is the OPERATOR-side config for the self-hosted Nixre instance
# (docker compose up -d). Secrets are read by nixre-core and the compose file;
# they must never be committed.
#
# Generate the two required secrets with:
#   openssl rand -hex 32
#
# Compose uses `:?` on the required values, so it refuses to start without
# them. Core additionally refuses to boot on a known published default.

# --- Required secrets -------------------------------------------------------

# Internal token used between nixre-core, nixre-ssh, and the deploy proxy.
NIXRE_INTERNAL_TOKEN=change-me-internal-token

# Secret for the embedded AI assistant provider calls. Also the base key every
# stored secret is encrypted with (provider keys, service env vars, GitHub
# PATs, webhook signing secrets). Changing it invalidates all of them.
NIXRE_AI_SECRET=change-me-ai-secret

# Postgres credentials. The old hard-coded `nixre`/`nixre` pair meant anything
# that reached the database network owned the instance.
POSTGRES_USER=nixre
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=nixre
# (DATABASE_URL in docker-compose is built from the three values above.)

# --- Registration -----------------------------------------------------------

# Server-side signup kill switch. Defaults to CLOSED when unset, so a fresh
# instance never opens signups by accident. Set to false to allow anyone to
# register (the first account then becomes admin), or toggle it live from the
# admin console once you are in.
NIXRE_REGISTRATION_CLOSED=true

# --- Deployment domain policy ----------------------------------------------

# Base domain for automatic deployment addresses (svc-<id>.<base>).
DEPLOY_BASE_DOMAIN=

# Comma-separated hostnames a deployment may NEVER claim. Custom domains are
# matched before every other routing rule, so list your own panel/git hosts
# here — e.g. git.example.com,ssh.example.com.
NIXRE_RESERVED_DOMAINS=

# --- Cloudflare DNS automation for tunnel-kind custom domains ---------------
# When set, a tunnel domain's proxied CNAME (<domain> -> <TUNNEL_ID>.cfargotunnel.com)
# is created/removed automatically via the Cloudflare API. The token needs
# Zone:Read + DNS:Edit on the zones users attach domains from. Leave empty to
# fall back to copy-paste DNS guidance.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_API_TOKEN=

# Optional token for the bundled cloudflared service (`--profile tunnels`).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Ports ------------------------------------------------------------------

# Where the deploy proxy listens for routed app traffic. 3003 is the default;
# the edge (host Caddy or Cloudflare Tunnel) forwards here.
DEPLOY_PROXY_PORT=3003
# Bind address for the published proxy port. Keep 127.0.0.1 unless your edge
# runs on another host.
DEPLOY_PROXY_BIND=127.0.0.1
# Idle timeout for proxied app traffic (streaming AI services need more).
DEPLOY_PROXY_TIMEOUT_MS=120000

# --- Runtime options policy (fail closed) -----------------------------------
# Host bind mounts for deployed services require BOTH an allowlist here AND an
# instance admin. Privileged mode and network_mode=host need their own flags.
# Leave the allowlist empty to disable host bind mounts entirely.
NIXRE_DEPLOY_BIND_ALLOWLIST=
NIXRE_DEPLOY_ALLOW_PRIVILEGED=false
NIXRE_DEPLOY_ALLOW_HOST_NETWORK=false

# --- Edge trust -------------------------------------------------------------
# Set to 1 (or a hop count) ONLY when your edge overwrites X-Forwarded-For on
# every request, which is what makes rate limiting key on the real client.
# Leave empty to key on the socket address (never spoofable).
TRUST_PROXY=

# --- Agent sandbox ----------------------------------------------------------
SANDBOX_IDLE_MS=900000
SANDBOX_MEMORY_BYTES=2147483648
SANDBOX_NANO_CPUS=2000000000
SANDBOX_PIDS_LIMIT=512
# Group id that owns the docker socket on the host; entrypoint.sh reads it when
# absent. Needed only for sandbox support.
DOCKER_GID=

# --- Secret-encryption salt ------------------------------------------------
# Feeds the HKDF that derives the encryption key. ROTATING THIS INVALIDATES
# EVERY STORED SECRET — treat it as a migration, not a tunable.
NIXRE_SECRET_SALT=nixre.instance.secret.v1

# --- Advanced / rarely needed -----------------------------------------------

# Public resolvers used to confirm custom-domain ownership (TXT challenge).
NIXRE_VERIFY_RESOLVERS=1.1.1.1,8.8.8.9,9.9.9.9

# Container names the SSRF guard refuses to fetch (comma-separated). List any
# peer a user should never be able to point a webhook or AI provider at.
BLOCKED_PEER_NAMES=nixre-core,nixre-db,nixre-ssh,nixre-web,nixre-tunnel

# Local development only: lets core boot with weak/known secrets. Never set
# this on a reachable instance.
ALLOW_INSECURE_DEFAULTS=

# --- Container networking ---------------------------------------------------
# Deployed app containers join this network. It MUST be a network nixre-core is
# on (core health-probes containers and proxies to them by IP) and must NEVER
# be the Postgres network — a Dockerfile is user-supplied code and creating a
# deployment only needs write access to a space.
NIXRE_APPS_NETWORK=nixre-apps
# Name of the internal database network, excluded from all container attachment.
NIXRE_DATA_NETWORK=nixre-data
# Network agent sandbox containers join (same rule: never the DB network).
# Leave unset to auto-select the first non-database network.
SANDBOX_NETWORK=

# --- Deployment limits ------------------------------------------------------
# Fork-bomb ceiling for deployed app containers.
DEPLOY_PIDS_LIMIT=512
# Services per repository. Each reserves CPU/RAM limits, so an uncapped count
# lets any space member reserve unbounded host resources.
DEPLOY_MAX_SERVICES_PER_REPO=20
